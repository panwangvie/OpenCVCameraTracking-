<Window x:Class="OpenCVCameraTracking.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}" Width="1160" Height="800"
        MinWidth="980" MinHeight="680" WindowStartupLocation="CenterOwner"
        Background="#101418" Foreground="#EAF0F4" ResizeMode="CanResizeWithGrip"
        Icon="Assets/AppIcon.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource StreamProfiles}" Foreground="#8FA2AD" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#172128" CornerRadius="8" Padding="12,7">
                <TextBlock Text="OpenCV · WPF" Foreground="#72D6B5" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#182127" BorderBrush="#2C3B44" BorderThickness="1"
                    CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource StreamProfiles}" FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <ListBox x:Name="ProfilesBox" Grid.Row="1" DisplayMemberPath="Name"
                             SelectionChanged="ProfilesBox_OnSelectionChanged" />
                    <TextBlock Grid.Row="2" Text="{DynamicResource ProfileName}" Margin="0,12,0,0" />
                    <TextBox x:Name="ProfileNameBox" Grid.Row="3" />
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="{DynamicResource ProfileAddress}" />
                        <TextBox x:Name="ProfileAddressBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="5">
                        <TextBlock Text="{DynamicResource ProfileSubAddress}" />
                        <TextBox x:Name="ProfileSubAddressBox" />
                    </StackPanel>
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ProfileGroup}" />
                            <TextBox x:Name="ProfileGroupBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource ProfileNotes}" />
                            <TextBox x:Name="ProfileNotesBox" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="ProfileEnabledBox" Grid.Row="7" Content="{DynamicResource StreamEnabled}" />
                    <TextBlock Grid.Row="7" Text="{DynamicResource StreamEnabledHint}" Foreground="#8FA2AD"
                               FontSize="11" Margin="156,9,0,0" VerticalAlignment="Top" />
                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{DynamicResource AddOrUpdate}" Click="AddOrUpdateButton_OnClick"
                                Background="#087F5B" BorderBrush="#18A979" Margin="0,3,5,3" />
                        <Button Grid.Column="1" Content="{DynamicResource Delete}" Click="DeleteButton_OnClick"
                                Margin="5,3,0,3" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#182127" BorderBrush="#2C3B44" BorderThickness="1"
                    CornerRadius="10" Padding="12">
                <TabControl x:Name="SettingsTabs">
                    <TabItem Header="{DynamicResource GeneralSettings}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Language}" Margin="0,4,0,0" />
                                <ComboBox x:Name="LanguageBox">
                                    <ComboBoxItem Content="{DynamicResource Chinese}" Tag="zh-CN" />
                                    <ComboBoxItem Content="{DynamicResource English}" Tag="en-US" />
                                </ComboBox>
                                <TextBlock Text="{DynamicResource VideoBackend}" />
                                <ComboBox x:Name="BackendBox">
                                    <ComboBoxItem Content="{DynamicResource BackendAuto}" Tag="Auto" />
                                    <ComboBoxItem Content="DirectShow" Tag="DirectShow" />
                                    <ComboBoxItem Content="Media Foundation" Tag="MediaFoundation" />
                                    <ComboBoxItem Content="FFmpeg" Tag="Ffmpeg" />
                                </ComboBox>
                                <TextBlock Text="{DynamicResource PreviewLayout}" />
                                <ComboBox x:Name="LayoutBox">
                                    <ComboBoxItem Content="{DynamicResource LayoutSingle}" Tag="Single" />
                                    <ComboBoxItem Content="2 × 2" Tag="Grid2" />
                                    <ComboBoxItem Content="3 × 3" Tag="Grid3" />
                                    <ComboBoxItem Content="4 × 4" Tag="Grid4" />
                                </ComboBox>
                                <TextBlock Text="{DynamicResource DefaultStream}" />
                                <ComboBox x:Name="DefaultStreamBox" DisplayMemberPath="Name" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{DynamicResource RtspSettings}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource RtspSettings}" FontSize="18" FontWeight="SemiBold" />
                                <CheckBox x:Name="LowLatencyBox" Content="{DynamicResource LowLatencyMode}" Margin="0,12,0,3" />
                                <TextBlock Text="{DynamicResource LowLatencyHint}" TextWrapping="Wrap"
                                           Foreground="#8FA2AD" FontSize="12" Margin="22,0,0,18" />
                                <Separator Margin="0,2,0,15" Background="#34454F" />
                                <TextBlock Text="{DynamicResource DetectionSettings}" FontSize="18" FontWeight="SemiBold" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource FaceConfidence}" />
                                    <TextBlock x:Name="FaceConfidenceText" Grid.Column="1" Foreground="#72D6B5" />
                                </Grid>
                                <Slider x:Name="FaceConfidenceSlider" Minimum="0.3" Maximum="0.9" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True" ValueChanged="ConfidenceSlider_OnValueChanged" Margin="0,7,0,18" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource AnimalConfidence}" />
                                    <TextBlock x:Name="AnimalConfidenceText" Grid.Column="1" Foreground="#72D6B5" />
                                </Grid>
                                <Slider x:Name="AnimalConfidenceSlider" Minimum="0.15" Maximum="0.8" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True" ValueChanged="ConfidenceSlider_OnValueChanged" Margin="0,7,0,5" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{DynamicResource OnvifSettings}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource OnvifHint}" Foreground="#8FA2AD" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource OnvifUser}" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource OnvifPassword}" Margin="8,0,0,0" />
                                    <TextBox x:Name="OnvifUserBox" Grid.Row="1" ToolTip="{DynamicResource OnvifUser}" />
                                    <PasswordBox x:Name="OnvifPasswordBox" Grid.Row="1" Grid.Column="1"
                                                 ToolTip="{DynamicResource OnvifPassword}"
                                                 Foreground="#E8F0F4" Background="#202B32" BorderBrush="#3B4D58"
                                                 BorderThickness="1" Padding="10,6" Margin="8,5,0,12" />
                                </Grid>
                                <Button Content="{DynamicResource DiscoverOnvif}" Click="DiscoverOnvifButton_OnClick" />
                                <ListBox x:Name="OnvifDevicesBox" Height="150" DisplayMemberPath="DisplayName"
                                         SelectionChanged="OnvifDevicesBox_OnSelectionChanged" />
                                <Button Content="{DynamicResource ImportOnvifStream}" Click="ImportOnvifButton_OnClick" />
                                <TextBlock Text="{DynamicResource OnvifPtz}" Margin="0,14,0,2" />
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Content="←" Click="PtzLeftButton_OnClick" />
                                    <Button Grid.Column="1" Content="■" Click="PtzStopButton_OnClick" />
                                    <Button Grid.Column="2" Content="→" Click="PtzRightButton_OnClick" />
                                    <Button Grid.Row="1" Grid.Column="1" Content="↑ / ↓" Click="PtzVerticalButton_OnClick" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PresetsBox" DisplayMemberPath="Name" />
                                    <Button Grid.Column="1" Content="{DynamicResource RefreshPresets}" Click="RefreshPresetsButton_OnClick" />
                                    <Button Grid.Column="2" Content="{DynamicResource GotoPreset}" Click="GotoPresetButton_OnClick" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{DynamicResource CameraProfiles}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource CameraProfilesHint}" Foreground="#8FA2AD" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <ListBox x:Name="CameraProfilesBox" Height="180" DisplayMemberPath="DisplayName"
                                         SelectionChanged="CameraProfilesBox_OnSelectionChanged" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="CameraProfileGroupBox" ToolTip="{DynamicResource ProfileGroup}" />
                                    <TextBox x:Name="CameraProfileNotesBox" Grid.Column="1" Margin="8,5,0,12"
                                             ToolTip="{DynamicResource ProfileNotes}" />
                                </Grid>
                                <CheckBox x:Name="CameraProfileEnabledBox" Content="{DynamicResource CameraEnabled}" />
                                <Button Content="{DynamicResource SaveCameraProfile}" Click="SaveCameraProfileButton_OnClick" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="#71838D" Text="settings.json · LocalAppData" />
            <Button Grid.Column="1" Content="{DynamicResource Cancel}" Click="CancelButton_OnClick" MinWidth="100" />
            <Button Grid.Column="2" Content="{DynamicResource Save}" Click="SaveButton_OnClick"
                    Background="#087F5B" BorderBrush="#18A979" MinWidth="110" />
        </Grid>
    </Grid>
</Window>
