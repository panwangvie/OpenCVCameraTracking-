<Window x:Class="OpenCVCameraTracking.RestrictedZoneSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource RestrictedZoneTitle}" Width="920" Height="620"
        MinWidth="640" MinHeight="440" Background="#101418" Foreground="#EAF0F4"
        Icon="Assets/AppIcon.ico" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="#2A3942" BorderThickness="1" Background="#080B0D">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" />
                <Canvas x:Name="SelectionCanvas" Background="#01000000" Cursor="Cross"
                        MouseLeftButtonDown="SelectionCanvas_OnMouseLeftButtonDown"
                        MouseMove="SelectionCanvas_OnMouseMove"
                        MouseLeftButtonUp="SelectionCanvas_OnMouseLeftButtonUp">
                    <Border x:Name="SelectionRectangle" Visibility="Collapsed"
                            BorderBrush="#FF5664" BorderThickness="3" Background="#30D93A45" />
                </Canvas>
            </Grid>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="{DynamicResource RestrictedZoneSelectionHint}" TextWrapping="Wrap"
                       VerticalAlignment="Center" MaxWidth="560" Foreground="#A7B8C1" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Cancel}" Click="CancelButton_OnClick" Margin="8,0,0,0" />
                <Button x:Name="ConfirmButton" Content="{DynamicResource Confirm}" Click="ConfirmButton_OnClick"
                        IsEnabled="False" Background="#087F5B" BorderBrush="#18A979" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
