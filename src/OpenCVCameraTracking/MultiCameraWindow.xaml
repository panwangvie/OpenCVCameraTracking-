<Window x:Class="OpenCVCameraTracking.MultiCameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource MultiCamera}" Width="1180" Height="760"
        MinWidth="720" MinHeight="480" Background="#080B0D" Foreground="#EAF0F4"
        WindowStartupLocation="CenterOwner" Icon="Assets/AppIcon.ico">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#182127" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource PreviewLayout}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="LayoutBox" Grid.Column="1" SelectionChanged="LayoutBox_OnSelectionChanged">
                    <ComboBoxItem Content="{DynamicResource LayoutSingle}" Tag="Single" />
                    <ComboBoxItem Content="2 × 2" Tag="Grid2" />
                    <ComboBoxItem Content="3 × 3" Tag="Grid3" />
                    <ComboBoxItem Content="4 × 4" Tag="Grid4" />
                </ComboBox>
                <TextBlock Grid.Column="2" Text="{DynamicResource MultiCameraHint}" Foreground="#8FA2AD"
                           VerticalAlignment="Center" Margin="14,0" />
                <Button Grid.Column="3" Content="{DynamicResource Close}" Click="CloseButton_OnClick" />
            </Grid>
        </Border>
        <ItemsControl x:Name="TilesBox" AllowDrop="True" PreviewMouseMove="TilesBox_OnPreviewMouseMove"
                      Drop="TilesBox_OnDrop" Background="#080B0D">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" BorderBrush="#2A3942" BorderThickness="1" Background="#11171B"
                            Visibility="{Binding TileVisibility}"
                            Tag="{Binding}" MouseDown="Tile_OnMouseDown">
                        <Grid>
                            <Image Source="{Binding Image}" Stretch="Uniform" />
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#A0162027"
                                    Padding="8,5" CornerRadius="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Status}" Foreground="#8FA2AD" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{DynamicResource WaitingPreview}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="#52636D" Visibility="{Binding PlaceholderVisibility}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
